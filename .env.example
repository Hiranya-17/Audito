# Copy this file to .env and fill in your own values. Never commit .env.
#
# Shared team database (MongoDB Atlas): paste the connection string from
# Atlas -> your cluster -> Connect -> Drivers. It looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# Local database (docker compose up -d):
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=audito
